# ─────────────────────────────────────────────────────────────
# Sybersek Master IR Workflow — Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit your real .env to GitHub.
# ─────────────────────────────────────────────────────────────

# ── Threat Intelligence APIs ──────────────────────────────────
VIRUSTOTAL_API_KEY=YOUR_VIRUSTOTAL_API_KEY
# Free tier: 500 lookups/day — https://www.virustotal.com/gui/join-us

ABUSEIPDB_API_KEY=YOUR_ABUSEIPDB_API_KEY
# Free tier: 1,000 lookups/day — https://www.abuseipdb.com/register

# ── Slack Notification ────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR_SLACK_WEBHOOK_URL
# Create at: https://api.slack.com/apps → Incoming Webhooks

# ── Google Sheets ─────────────────────────────────────────────
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID
# The long ID in your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/YOUR_GOOGLE_SHEET_ID/edit
# Sheet1 = IR log (26 columns), Sheet2!A1 = persistent ticket counter (set to 0 before first run)

# ── Microsoft Entra / Azure App Registration ──────────────────
ENTRA_TENANT_ID=YOUR_ENTRA_TENANT_ID
AZURE_APP_CLIENT_ID=YOUR_AZURE_APP_CLIENT_ID
AZURE_CLIENT_SECRET=YOUR_AZURE_CLIENT_SECRET
# Required for Graph Sign-in Monitor only.
# Register an app in Azure Portal → API permissions: AuditLog.Read.All, Directory.Read.All

# ── ngrok Tunnel ──────────────────────────────────────────────
NGROK_DOMAIN=YOUR_NGROK_DOMAIN.ngrok-free.app
# Required to receive Power Automate webhooks on a local n8n instance.
# For production: replace with your cloud-hosted n8n domain.

# ── n8n Instance ──────────────────────────────────────────────
N8N_HOST=localhost
N8N_PORT=5678
# Default Docker deployment: http://localhost:5678
