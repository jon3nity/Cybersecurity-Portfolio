    {
      "parameters": {
        "jsCode": "const signIns = $input.first().json.value || [];\nif (signIns.length === 0) return [];\nconst ipGroups = {};\nfor (const s of signIns) {\n  const ip = s.ipAddress || 'unknown';\n  const user = s.userPrincipalName || 'unknown';\n  const time = s.createdDateTime;\n  if (!ipGroups[ip]) ipGroups[ip] = { count: 0, users: new Set(), earliest: time };\n  ipGroups[ip].count++;\n  ipGroups[ip].users.add(user);\n  if (time < ipGroups[ip].earliest) ipGroups[ip].earliest = time;\n}\nconst alerts = [];\nfor (const [ip, data] of Object.entries(ipGroups)) {\n  if (data.count >= 2) {\n    const users = [...data.users];\n    const isSpray = users.length > 1;\n    alerts.push({ alert_id: 'GRAPH-BF-' + ip.replace(/\\./g, '-') + '-' + new Date(data.earliest).getTime(), incident_type: 'Brute Force Attempt', severity: data.count >= 15 ? 'Critical' : data.count >= 10 ? 'High' : 'Medium', source_ip: ip, hostname: 'sybersek-entra', user: users.join(', '), description: isSpray ? 'Password spray detected: ' + data.count + ' failures across ' + users.length + ' accounts from ' + ip : 'Brute force detected: ' + data.count + ' failed logins for ' + users[0] + ' from ' + ip, file_hash: 'N/A', failed_login_count: data.count, sender_email: '', email_body: '' });\n  }\n}\nreturn alerts.map(a => ({ json: a }));"
